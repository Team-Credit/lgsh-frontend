# 로지신해 Frontend 환경변수 (템플릿)

# API 설정
VITE_API_BASE_URL=/api/v1
# Mock 인증 사용 여부 (백엔드 없이 개발 시 true)
VITE_USE_MOCK_AUTH=true

# 앱 설정
VITE_APP_ENV=development
VITE_APP_NAME=로지신해
VITE_APP_VERSION=1.0.0

# 토큰 설정
VITE_ACCESS_TOKEN_KEY=lgsh_access_token
VITE_REFRESH_TOKEN_KEY=lgsh_refresh_token
VITE_SESSION_TIMEOUT=60

# 디버그
VITE_DEBUG_MODE=true
